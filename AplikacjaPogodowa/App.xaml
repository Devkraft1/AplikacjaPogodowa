<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AplikacjaPogodowa"
             x:Class="AplikacjaPogodowa.App">
    <Application.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="JetBrainsMonoNerdRegular" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="JetBrainsMonoNerdRegular" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1B1B1B, Dark=#FFFFFF}"/>
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="JetBrainsMonoNerdRegular" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="JetBrainsMonoNerdRegular" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
