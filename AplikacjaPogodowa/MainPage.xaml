<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AplikacjaPogodowa.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView
        Margin="1,10,1,1"
        Padding="2,0,2,2"
        VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
            Spacing="5">
                <Border
                Stroke="Gray"
                StrokeThickness="1">
                    <Button
                    x:Name="locationBtn"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                    TextColor="{AppThemeBinding Light=#1B1B1B, Dark=#FFFFFF}"
                    Text="&#xeb1a; Miasto, Województwo"
                    FontSize="20"
                    Clicked="ToggleSearchMenu"/>
                </Border>
                <Grid ColumnDefinitions="Auto,*"
                HorizontalOptions="Fill"
                ColumnSpacing="10">
                    <Label
                    x:Name="currentTemp"
                    Grid.Column="0"
                    Text="XX.Y&#x00B0;C"
                    FontSize="40"
                    VerticalTextAlignment="Center"
                    HorizontalOptions="Start"/>
                    <Label
                    x:Name="currentWeatherCodeText"
                    Grid.Column="1"
                    Text="Przelotne opady deszczu"
                    MaxLines="2"
                    LineBreakMode="WordWrap"
                    VerticalTextAlignment="Center"
                    HorizontalTextAlignment="End"
                    FontSize="25"
                    HorizontalOptions="Fill"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*"
                HorizontalOptions="Fill"
                ColumnSpacing="10">
                    <Label
                    x:Name="feelsLike"
                    Grid.Column="0"
                    Text="XX.Y&#x00B0;C"
                    FontSize="25"
                    HorizontalTextAlignment="Start"
                    VerticalTextAlignment="Center"/>

                    <Label
                    x:Name="currentWindData"
                    Grid.Column="1"
                    Text="&#xf059d; XX.Ykm/h&#xe353;"
                    FontSize="25"
                    HorizontalTextAlignment="End"
                    VerticalTextAlignment="Center"
                    HorizontalOptions="Fill"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*"
                HorizontalOptions="Fill"
                ColumnSpacing="10">

                    <Label
                    x:Name="currentHumidity"
                    Grid.Column="0"
                    Text="&#xe373; XX%"
                    FontSize="25"
                    HorizontalTextAlignment="Start"
                    VerticalTextAlignment="Center"/>
                    <Label
                    x:Name="currentPressure"
                    Grid.Column="1"
                    Text="&#xe372;XXXX hPa"
                    FontSize="25"
                    HorizontalTextAlignment="End"
                    VerticalTextAlignment="Center"
                    HorizontalOptions="Fill"/>
                </Grid>
                <ScrollView
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                x:Name="hourlyScroll">
                    <Grid
                    x:Name="hourlyForecast"
                    RowDefinitions="Auto">
                    </Grid>
                </ScrollView>
                <Grid RowDefinitions="60, 60, 60, 60, 60, 60, 60"
                  ColumnDefinitions="*"
                  HorizontalOptions="Fill"
                  x:Name="dailyForecast">
                </Grid>
                <Grid
                RowDefinitions="auto"
                ColumnDefinitions="*, *"
                ColumnSpacing="5"
                x:Name="SunMoonData">
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <Grid x:Name="LoadingOverlay"
                IsVisible="False"
                BackgroundColor="#99000000"
                ZIndex="100"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
            <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="15">
                <ActivityIndicator
                        IsRunning="{Binding Source={x:Reference LoadingOverlay}, Path=IsVisible}"
                        Color="White"
                        WidthRequest="50"
                        HeightRequest="50" />
                <Label
                    x:Name="loadingMessage"
                    Text="Aktualizowanie pogody..."
                    TextColor="White"
                    FontSize="18"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
        <Grid
            x:Name="searchMenu"
            IsVisible="False"
            BackgroundColor="#99000000"
            ZIndex="99"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <ScrollView
                VerticalScrollBarVisibility="Never">
                <Grid
                    Margin="5,10,5,0"
                    Padding="1"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}"
                    ColumnDefinitions="*, auto"
                    x:Name="searchGrid"
                    SizeChanged="CalculateSearchRowHeight"
                    ColumnSpacing="2"
                    RowSpacing="2">
                    <Border 
                        Stroke="Gray"
                        StrokeThickness="1"
                        Grid.Column="0"
                        Grid.Row="0">
                        <Entry
                            BackgroundColor="Transparent"
                            Placeholder="Wpisz miasto..."
                            Completed="ShowSearchResults"
                            FontSize="20"
                            />
                    </Border>
                    <Border
                        Stroke="Gray"
                        StrokeThickness="1"
                        Grid.Column="1"
                        Grid.Row="0">
                        <Button 
                            BackgroundColor="Transparent"
                            x:Name="backBtn"
                            FontSize="30"
                            Clicked="ToggleSearchMenu"/>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>