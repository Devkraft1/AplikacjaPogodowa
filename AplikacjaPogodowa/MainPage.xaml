<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AplikacjaPogodowa.MainPage"
             Shell.NavBarIsVisible="False"
             Padding="10,10,10,10">

    <ScrollView
        VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Spacing="5">
            <Button
                 x:Name="locationBtn"
                 Text="&#xeb1a; Miasto, Województwo"
                 FontSize="20"/>
            <HorizontalStackLayout
                HorizontalOptions="Center">
                <Label 
                x:Name="currentTemp"
                Text="XX.Y&#x00B0;"
                FontSize="50"/>
                <Label 
                x:Name="currentWeatherCodeText"
                Text="Przelotne opady deszczu"
                Padding="0,0,15,0"
                MaxLines="2"
                LineBreakMode="WordWrap"
                VerticalTextAlignment="Center"
                FontSize="25"
                WidthRequest="230"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout
                HorizontalOptions="Center">
                <Label
                    HorizontalTextAlignment="Start"
                    x:Name="todayMinMaxTemp"
                    Text="&#xe353;XX.Y&#x00B0; &#xe340;XX.Y&#x00B0;"
                    FontSize="25"/>
                <Label 
                    HorizontalTextAlignment="End"
                    x:Name="currentWindData"
                    Text="&#xf059d; XX.Ykm/h&#xe353;"
                    FontSize="25"
                    Margin="0,0,0,0"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout
                HorizontalOptions="Center">
                <Label
                    x:Name="currrentHumidity"
                    Text="&#xe373; XX%"
                    FontSize="25"/>
                <Label
                    x:Name="currrentPressure"
                    Text="&#xe372;XXXX hPa"
                    FontSize="25"
                    HorizontalTextAlignment="End"
                    WidthRequest="280"/>
            </HorizontalStackLayout>
            <ScrollView
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never">
                <Grid
                    x:Name="hourlyForecastLayout"
                    RowDefinitions="150"
                    ColumnDefinitions="75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75"
                    >
                    <Label 
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="Blue"/>
                    <Label 
                        Grid.Row="0"
                        Grid.Column="14"
                        BackgroundColor="Blue"/>
                    <Label 
                        Grid.Row="0"
                        Grid.Column="23"
                        BackgroundColor="Blue"/>
                </Grid>
            </ScrollView>
            <Grid RowDefinitions="60, 60, 60, 60, 60, 60, 60"
                  ColumnDefinitions="380"
                  HeightRequest="420"
                  Margin="0,10,0,0">
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    RowDefinitions="60"
                    ColumnDefinitions="190, 190"
                    BackgroundColor="Red">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Dzisiaj"
                        FontSize="25"
                        VerticalTextAlignment="Center"
                        Padding="5,0,0,0"/>
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="&#xe353;XX.Y&#x00B0; &#xe340;XX.Y&#x00B0;"
                        FontSize="20"
                        VerticalTextAlignment="Center"
                        HorizontalOptions="End"/>
                </Grid>
            </Grid>
            <Grid
                RowDefinitions="150"
                ColumnDefinitions="190, 190">
                <Label 
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Blue"/>
                <Label 
                    Margin="5,0,0,0"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Red"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>