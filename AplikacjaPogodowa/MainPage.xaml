<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AplikacjaPogodowa.MainPage"
             Shell.NavBarIsVisible="False">

    <ScrollView
        Margin="2,10,0,0"
        VerticalScrollBarVisibility="Never">
        <VerticalStackLayout
            Spacing="5"
            Padding="0,0,0,0">
            <Button
                 x:Name="locationBtn"
                 Text="&#xeb1a; Miasto, Województwo"
                 FontSize="20"/>
            <HorizontalStackLayout
                HorizontalOptions="Center">
                <Label 
                x:Name="currentTemp"
                Text="XX.Y&#x00B0;C"
                FontSize="50"/>
                <Label 
                x:Name="currentWeatherCodeText"
                Text="Przelotne opady deszczu"
                Padding="0,0,30,0"
                MaxLines="2"
                LineBreakMode="WordWrap"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"
                FontSize="25"
                WidthRequest="230"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout
                HorizontalOptions="Center">
                <Label
                    HorizontalTextAlignment="Start"
                    x:Name="feelsLike"
                    Text="XX.Y&#x00B0;C"
                    FontSize="25"/>
                <Label 
                    HorizontalTextAlignment="End"
                    x:Name="currentWindData"
                    Text="&#xf059d; XX.Ykm/h&#xe353;"
                    FontSize="25"
                    WidthRequest="270"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout
                HorizontalOptions="Center">
                <Label
                    x:Name="currentHumidity"
                    Text="&#xe373; XX%"
                    FontSize="25"/>
                <Label
                    x:Name="currentPressure"
                    Text="&#xe372;XXXX hPa"
                    FontSize="25"
                    HorizontalTextAlignment="End"
                    WidthRequest="280"/>
            </HorizontalStackLayout>
            <ScrollView
                Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never">
                <Grid
                    x:Name="hourlyForecast"
                    RowDefinitions="150"
                    ColumnDefinitions="75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75"
                    >
                </Grid>
            </ScrollView>
            <Grid RowDefinitions="60, 60, 60, 60, 60, 60, 60"
                  ColumnDefinitions="380"
                  HeightRequest="420"
                  Margin="0,10,0,0"
                  x:Name="dailyForecast">
                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    RowDefinitions="60"
                    ColumnDefinitions="30, 150, 190"
                    BackgroundColor="Red"
                    Margin="0,0,5,0">
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="Dzisiaj"
                        FontSize="25"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="Start"
                        Padding="5,0,0,0"/>
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="&#xe31a;"
                        FontSize="50"
                        VerticalTextAlignment="Start"
                        HorizontalOptions="Start"
                        TranslationY="-10"/>
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        Text="&#xe353;XX.Y&#x00B0; &#xe340;XX.Y&#x00B0;"
                        FontSize="20"
                        VerticalTextAlignment="Center"
                        HorizontalTextAlignment="End"
                        HorizontalOptions="End"
                        Padding="0,0,5,0"/>
                </Grid>
            </Grid>
            <Grid
                RowDefinitions="150"
                ColumnDefinitions="190, 190">
                <Label 
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="Blue"/>
                <Label 
                    Margin="5,0,0,0"
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="Red"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>